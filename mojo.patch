+# ===----------------------------------------------------------------------=== #
+
+from std._plugin._trait import PluginHooks
+from std.collections.string.string_span import _get_kgen_string
+from std.ffi import external_call
+from std.reflection import SourceLocation
+
+
+struct BareMetalPlugin(PluginHooks):
+    """`PluginHooks` implementation for freestanding/bare-metal targets
+    (a triple whose OS component is `none`, e.g. `aarch64-unknown-none-elf`).
+
+    There is no libc to link against on these targets, so `debug_assert`'s
+    default failure path (`_printf` -> `KGEN_CompilerRT_fprintf` ->
+    `vfprintf`, plus the `fdopen`/`dup`/`fclose` FILE* plumbing) is
+    unusable. This plugin instead dispatches the failure message to a
+    single fixed-arity extern symbol, `__mojo_baremetal_debug_write`, that
+    the freestanding program (kernel) is expected to define with
+    `@export("__mojo_baremetal_debug_write") ... abi("C")`. `abort()`'s
+    fallback (`llvm.intr.trap`) is already libc-free, so `abort_fn` is left
+    at its default no-op.
+    """
+
+    comptime name: __mlir_type.`!kgen.string` = _get_kgen_string["baremetal"]()
+
+    comptime _handles_debug_assert: Bool = True
+
+    @staticmethod
+    def debug_assert_emit_fn[
+        O: Origin
+    ](message: Pointer[Byte, O], length: Int, loc: SourceLocation):
+        """Forwards the assertion message to the program-supplied sink.
+
+        The freestanding program must define a matching symbol, e.g.:
+
+        ```mojo
+        @export("__mojo_baremetal_debug_write")
+        def _debug_write(message: Pointer[Byte, ImmAnyOrigin], length: Int) abi("C"):
+            for i in range(length):
+                putc(message[unsafe_offset=i])
+        ```
+
+        Parameters:
+            O: The origin of the message pointer.
+
+        Args:
+            message: Pointer to the nul-terminated message bytes.
+            length: Length in bytes (excluding the trailing nul).
+            loc: Source location of the failing assertion. Not currently
+                forwarded — the message already carries the relevant
+                context for a "safe"-mode `check_bounds` failure.
+        """
+        _ = loc
+        # Pass a raw integer address rather than a typed `Pointer` across the
+        # FFI boundary: `Pointer`'s concrete origin (an implementation detail
+        # of whichever stdlib caller reaches this hook) can carry
+        # alias/lifetime attributes that don't match a freestanding
+        # program's own concrete `Pointer` type at the same symbol, which
+        # the backend then rejects as "conflicting attributes" on the two
+        # declarations of one external symbol. An address (`Int`) has no
+        # such attributes and is unambiguous.
+        external_call["__mojo_baremetal_debug_write", NoneType](
+            Int(message), length
+        )

+// limitations under the License.
+//===----------------------------------------------------------------------===//
+
+#include "CABIWin64.h"
+#include "LLVMLoweringUtils.h"
+
+using namespace M;
+using namespace M::KGEN;
+
+//===----------------------------------------------------------------------===//
+// Constructor
+//===----------------------------------------------------------------------===//
+
+Win64ABIInfo::Win64ABIInfo(mlir::MLIRContext *ctx,
+                           const LLVMDataLayout &dataLayout)
+    : CABIInfo(ctx, dataLayout) {}
+
+//===----------------------------------------------------------------------===//
+// Argument Classification
+//===----------------------------------------------------------------------===//
+
+CoercionInfo Win64ABIInfo::classifyArgumentType(mlir::Type type,
+                                                mlir::Location loc,
+                                                bool isVariadicArg) const {
+  if (isa<mlir::LLVM::LLVMArrayType>(type))
+    return CoercionInfo::indirectArgument(/*useByval=*/false);
+
+  auto structType = dyn_cast<mlir::LLVM::LLVMStructType>(type);
+  if (!structType)
+    return CoercionInfo{}; // Identity: non-structs pass directly.
+
+  int64_t size = CabiUtils::getStructSize(structType, dataLayout);
+
+  // Win64 ABI rule: Structs whose size is exactly 1, 2, 4, or 8 bytes are
+  // passed by value in an integer register (coerced to integer).
+  switch (size) {
+  case 1:
+  case 2:
+  case 4:
+  case 8:
+    return CabiUtils::classifySmallIntegerStruct(size, ctx);
+  default:
+    // Any other size (e.g. 3, 5, 6, 7, or >8 bytes) is passed by reference
+    // (caller allocates a temporary and passes a pointer to it, non-byval).
+    return CoercionInfo::indirectArgument(/*useByval=*/false);
+  }
+}
+
+//===----------------------------------------------------------------------===//
+// Return Value Classification
+//===----------------------------------------------------------------------===//
+
+CoercionInfo Win64ABIInfo::classifyReturnType(mlir::Type type,
+                                              mlir::Location loc) const {
+  auto structType = dyn_cast<mlir::LLVM::LLVMStructType>(type);
+  if (!structType)
+    return CoercionInfo{}; // Identity: non-structs return directly.
+
+  int64_t size = CabiUtils::getStructSize(structType, dataLayout);
+
+  // Win64 ABI rule: Structs whose size is exactly 1, 2, 4, or 8 bytes are
+  // returned in RAX (coerced to integer).
+  switch (size) {
+  case 1:
+  case 2:
+  case 4:
+  case 8:
+    return CabiUtils::classifySmallIntegerStruct(size, ctx);
+  default:
+    // Any other size is returned via a hidden sret pointer.
+    return CoercionInfo::sretReturn();
+  }
+}
diff --git a/Mojo/lib/KGENToLLVM/CABIWin64.h b/Mojo/lib/KGENToLLVM/CABIWin64.h
